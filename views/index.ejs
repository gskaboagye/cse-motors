<%- include("partials/header") %>

<nav>
  <%- nav %>
</nav>

<main>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-text">
      <h1>Welcome to CSE Motors!</h1>
      <h2>DMC Delorean</h2>

      <p class="price"><strong>Price:</strong> $12,345</p>
      <p class="mileage"><strong>Mileage:</strong> 45,000 mi</p>

      <ul>
        <li>3 Cup Holders</li>
        <li>Superman Doors</li>
        <li>Fuzzy Dice</li>
      </ul>

      <a href="/inv/detail/1" class="btn" aria-label="View DMC Delorean details">Own Today</a>
    </div>

    <div class="hero-image">
      <img src="/images/vehicles/delorean.png" alt="DMC Delorean sports car">
    </div>
  </section>

  <!-- Content Section -->
  <section class="content">
    <article class="upgrades">
      <h3>Delorean Upgrades</h3>

      <div class="upgrade-grid">
        <figure>
          <img src="/images/upgrades/flux-cap.jpg" alt="Flux Capacitor upgrade">
          <figcaption><a href="#">Flux Capacitor</a></figcaption>
        </figure>

        <figure>
          <img src="/images/upgrades/flame.jpg" alt="Flame decals upgrade">
          <figcaption><a href="#">Flame Decals</a></figcaption>
        </figure>

        <figure>
          <img src="/images/upgrades/sticker.jpg" alt="Delorean bumper sticker">
          <figcaption><a href="#">Bumper Stickers</a></figcaption>
        </figure>

        <figure>
          <img src="/images/upgrades/hub-cap.jpg" alt="Delorean hub caps">
          <figcaption><a href="#">Hub Caps</a></figcaption>
        </figure>
      </div>
    </article>

    <article class="reviews">
      <h3>DMC Delorean Reviews</h3>
      <ul>
        <li>"So fast it's almost like traveling in time." (4/5)</li>
        <li>"Coolest ride on the road." (4/5)</li>
        <li>"I'm feeling McFly!" (5/5)</li>
        <li>"The most futuristic ride of our day." (4.5/5)</li>
        <li>"80's livin and I love it!" (5/5)</li>
      </ul>
    </article>
  </section>
</main>

<%- include("partials/footer") %>