<% if (typeof notice !== "undefined" && notice.length > 0) { %>
  <div class="notice">
    <%= notice[0] %>
  </div>
<% } %>

<section class="favorites-page">
  <h1><%= title %></h1>
  <p class="favorites-intro">Here are the vehicles you have saved to your favorites list.</p>

  <% if (favorites && favorites.length > 0) { %>
    <ul class="favorites-list">
      <% favorites.forEach(vehicle => { %>
        <li class="favorite-card">
          <img src="<%= vehicle.inv_thumbnail %>" alt="<%= vehicle.inv_make %> <%= vehicle.inv_model %>">

          <div class="favorite-content">
            <h2>
              <a href="/inv/detail/<%= vehicle.inv_id %>">
                <%= vehicle.inv_year %> <%= vehicle.inv_make %> <%= vehicle.inv_model %>
              </a>
            </h2>

            <div class="favorite-meta">
              <p class="favorite-price">
                <%= new Intl.NumberFormat("en-US", {
                  style: "currency",
                  currency: "USD"
                }).format(vehicle.inv_price) %>
              </p>
              <p><strong>Mileage:</strong> <%= new Intl.NumberFormat("en-US").format(vehicle.inv_miles) %> miles</p>
              <p><strong>Color:</strong> <%= vehicle.inv_color %></p>
            </div>
          </div>

          <div class="favorite-actions">
            <a class="favorite-btn" href="/inv/detail/<%= vehicle.inv_id %>">View Details</a>
            <a class="favorite-remove" href="/favorites/remove/<%= vehicle.favorite_id %>">Remove</a>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <div class="empty-favorites">
      <p>You have no saved favorites yet.</p>
      <a href="/inv/">Browse Inventory</a>
    </div>
  <% } %>
</section>