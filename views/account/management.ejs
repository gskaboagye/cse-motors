<% if (typeof notice !== "undefined" && notice.length > 0) { %>
  <div class="notice">
    <%= notice[0] %>
  </div>
<% } %>

<% if (errors) { %>
  <ul class="errors">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<h1><%= title %></h1>

<% if (accountData && (accountData.account_type === "Employee" || accountData.account_type === "Admin")) { %>
  <h2>Welcome <%= accountData.account_firstname %></h2>
<% } %>

<p>
  <a href="/account/update/<%= accountData.account_id %>" title="Update account information">
    Update Account Information
  </a>
</p>

<% if (accountData && (accountData.account_type === "Employee" || accountData.account_type === "Admin")) { %>
  <h3>Inventory Management</h3>
  <p>
    <a href="/inv/" title="Go to inventory management">Manage Inventory</a>
  </p>
<% } %>