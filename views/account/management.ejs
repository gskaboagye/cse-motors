<% if (typeof notice !== "undefined" && notice.length > 0) { %>
  <div class="notice">
    <%= notice[0] %>
  </div>
<% } %>

<% if (errors && errors.array().length > 0) { %>
  <ul class="errors">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<h1><%= title %></h1>

<!-- =========================
     USER GREETING
========================= -->
<p class="welcome-message">
  Welcome back, <strong><%= accountData.account_firstname %></strong>!
</p>

<!-- =========================
     ACCOUNT ACTIONS
========================= -->
<section class="account-actions">
  <h2>Account Options</h2>

  <ul>
    <li>
      <a href="/account/update/<%= accountData.account_id %>" title="Update account information">
        Update Account Information
      </a>
    </li>

    <li>
      <a href="/favorites" title="View your saved vehicles">
        View My Favorites
      </a>
    </li>
  </ul>
</section>

<!-- =========================
     INVENTORY (EMPLOYEE/ADMIN ONLY)
========================= -->
<% if (accountData.account_type === "Employee" || accountData.account_type === "Admin") { %>

  <section class="inventory-management">
    <h2>Inventory Management</h2>

    <p>
      <a href="/inv/" title="Go to inventory management">
        Manage Inventory
      </a>
    </p>
  </section>

<% } %>