<% if (typeof notice !== "undefined" && notice.length > 0) { %>
  <div class="notice">
    <%= notice[0] %>
  </div>
<% } %>

<% if (errors) { %>
  <ul class="errors">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<h1><%= title %></h1>

<section class="account-form-card">
  <h2>Account Update</h2>

  <form action="/account/update" method="post" class="account-form">
    <div class="form-group">
      <label for="account_firstname">First Name</label>
      <input
        type="text"
        id="account_firstname"
        name="account_firstname"
        required
        value="<%= typeof account_firstname !== 'undefined' ? account_firstname : '' %>"
      >
    </div>

    <div class="form-group">
      <label for="account_lastname">Last Name</label>
      <input
        type="text"
        id="account_lastname"
        name="account_lastname"
        required
        value="<%= typeof account_lastname !== 'undefined' ? account_lastname : '' %>"
      >
    </div>

    <div class="form-group">
      <label for="account_email">Email Address</label>
      <input
        type="email"
        id="account_email"
        name="account_email"
        required
        value="<%= typeof account_email !== 'undefined' ? account_email : '' %>"
      >
    </div>

    <input type="hidden" name="account_id" value="<%= account_id %>">

    <button type="submit">Update Account</button>
  </form>
</section>

<section class="account-form-card">
  <h2>Change Password</h2>
  <p class="password-hint">
    Enter a new password to replace your current password. Password must be at least
    12 characters and contain at least 1 uppercase letter, 1 lowercase letter,
    1 number, and 1 symbol.
  </p>

  <form action="/account/update-password" method="post" class="account-form">
    <div class="form-group">
      <label for="account_password">New Password</label>
      <input
        type="password"
        id="account_password"
        name="account_password"
        required
        pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{12,}$"
        title="Must be at least 12 characters and include uppercase, lowercase, number, and symbol."
      >
    </div>

    <input type="hidden" name="account_id" value="<%= account_id %>">

    <button type="submit">Update Password</button>
  </form>
</section>